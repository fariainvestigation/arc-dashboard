# No provider key belongs in this file or in the built bundle.
# All Gemini traffic is routed through the ARC AI gateway Worker, which holds
# GOOGLE_API_KEY as a Cloudflare Worker secret.
#
# Optional: override the gateway base URL for local development against a
# `wrangler dev` instance. Defaults to /ai/google in production.
# VITE_ARC_AI_GATEWAY="http://127.0.0.1:8787/ai/google"
