# ARC MOTION configuration. Copy to .env and edit. Never commit .env or share it.
# Local server
ARC_PORT=8790
ARC_HOST=127.0.0.1
# Data directory (optional; defaults to ./data so the app moves as a folder)
# ARC_DATA_DIR=./data

# Optional AI (leave blank to disable; ALL core features work without AI)
# ARC_AI_PROVIDER=anthropic        # anthropic | openai
# ARC_AI_MODEL=claude-sonnet-4-6
# ARC_AI_KEY=
# ARC_AI_BASE=https://api.openai.com/v1   # for OpenAI-compatible providers
